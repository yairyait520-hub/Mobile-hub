-- Delta Executor Auto-Farm Script
-- Creado para:workspace.EverythingElse.FinalSAS.WinPad.WinBlock14

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Eliminar GUI anterior si existe
local oldGui = LocalPlayer.PlayerGui:FindFirstChild("FarmGuiSystem")
if oldGui then oldGui:Destroy() end

-- Crear GUI Principal
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FarmGuiSystem"
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

-- Crear Botón de Farm
local FarmButton = Instance.new("TextButton")
FarmButton.Name = "FarmButton"
FarmButton.Size = UDim2.new(0, 100, 0, 100) -- Botón cuadrado
FarmButton.Position = UDim2.new(0.5, -50, 0.5, -50)
FarmButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
FarmButton.Text = "FARM"
FarmButton.TextColor3 = Color3.fromRGB(255, 255, 255)
FarmButton.Font = Enum.Font.GothamBold
FarmButton.TextSize = 22
FarmButton.Parent = ScreenGui

-- Redondear Botón
local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(1, 0) -- Lo hace circular
Corner.Parent = FarmButton

-- Añadir Borde Neón
local Stroke = Instance.new("UIStroke")
Stroke.Thickness = 3
Stroke.Color = Color3.fromRGB(0, 255, 204)
Stroke.Parent = FarmButton

---------------------------------------------------------
-- LÓGICA DE ARRASTRE (DRAGGABLE) PARA MÓVILES
---------------------------------------------------------
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    FarmButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

FarmButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FarmButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

FarmButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

---------------------------------------------------------
-- LÓGICA DE TELETRANSPORTE (FARM)
---------------------------------------------------------
FarmButton.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        -- 1. Intentar encontrar el WinBlock
        local success, target = pcall(function()
            return workspace.EverythingElse.FinalSAS.WinPad.WinBlock14
        end)
        
        if success and target then
            -- Teletransportarse al Win
            hrp.CFrame = target.CFrame
            print("Teletransportado a WinBlock14")
            
            task.wait(0.6) -- Espera corta para asegurar que el server registre la win
            
            -- 2. Teletransportarse al Spawn
            local spawnPoint = workspace:FindFirstChild("SpawnLocation")
            if spawnPoint then
                hrp.CFrame = spawnPoint.CFrame
                print("Regresado a SpawnLocation")
            else
                warn("No se encontró SpawnLocation en workspace")
            end
        else
            warn("No se encontró la ruta: workspace.EverythingElse.FinalSAS.WinPad.WinBlock14")
        end
    end
end)

print("Script de Farm cargado correctamente.")

